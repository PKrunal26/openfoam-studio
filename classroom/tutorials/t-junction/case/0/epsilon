FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform {{epsMain}};

boundaryField
{
    inletMain
    {
        type            fixedValue;
        value           uniform {{epsMain}};
    }

    inletBranch
    {
        type            fixedValue;
        value           uniform {{epsBranch}};
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            epsilonWallFunction;
        value           uniform {{epsMain}};
    }
}

