FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-07;
        relTol          0.05;
    }

    "(U|k|epsilon|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;

    // The run stops early once every residual is below its target.
    residualControl
    {
        p               {{tolerance}};
        U               {{tolerance}};
        "(k|epsilon|omega)" {{tolerance}};
    }
}

relaxationFactors
{
    equations
    {
        U               {{relax}};
        ".*"            {{relax}};
    }
}

