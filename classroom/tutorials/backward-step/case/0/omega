FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{omegaIn}};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform {{omegaIn}};
    }

    outlet
    {
        type            zeroGradient;
    }

    upperWall
    {
        type            omegaWallFunction;
        value           uniform {{omegaIn}};
    }

    lowerWall
    {
        type            omegaWallFunction;
        value           uniform {{omegaIn}};
    }

    frontAndBack
    {
        type            empty;
    }
}

