FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Backward-facing step. Step height H = 25 mm, inlet channel height 25 mm,
// 4H of inlet channel and 16H downstream of the step.

convertToMeters 1;

vertices
(
    (-0.1 0.025 0)      // 0
    ( 0   0.025 0)      // 1  step corner
    ( 0.4 0.025 0)      // 2
    (-0.1 0.05  0)      // 3
    ( 0   0.05  0)      // 4
    ( 0.4 0.05  0)      // 5
    ( 0   0     0)      // 6  foot of the step
    ( 0.4 0     0)      // 7

    (-0.1 0.025 0.005)  // 8
    ( 0   0.025 0.005)  // 9
    ( 0.4 0.025 0.005)  // 10
    (-0.1 0.05  0.005)  // 11
    ( 0   0.05  0.005)  // 12
    ( 0.4 0.05  0.005)  // 13
    ( 0   0     0.005)  // 14
    ( 0.4 0     0.005)  // 15
);

blocks
(
    hex (0 1 4 3 8 9 12 11)   ({{nxUp}} {{ny}} 1) simpleGrading (1 1 1)   // inlet channel
    hex (1 2 5 4 9 10 13 12)  ({{nxDown}} {{ny}} 1) simpleGrading (1 1 1) // above the step level
    hex (6 7 2 1 14 15 10 9)  ({{nxDown}} {{ny}} 1) simpleGrading (1 1 1) // behind the step
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 8 11 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (2 5 13 10)
            (7 2 10 15)
        );
    }
    upperWall
    {
        type wall;
        faces
        (
            (3 11 12 4)
            (4 12 13 5)
        );
    }
    lowerWall
    {
        type wall;
        faces
        (
            (0 1 9 8)
            (6 14 9 1)
            (6 7 15 14)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 4 1)
            (1 4 5 2)
            (6 1 2 7)
            (8 9 12 11)
            (9 10 13 12)
            (14 15 10 9)
        );
    }
);

