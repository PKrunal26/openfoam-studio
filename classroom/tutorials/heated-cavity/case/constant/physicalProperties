FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Air as a Boussinesq fluid: density varies linearly with temperature,
// rho = rho0 (1 - beta (T - T0)), and only in the buoyancy term.

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          eConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       28.96;
    }
    equationOfState
    {
        rho0            {{rho0}};
        T0              {{Tmean}};
        beta            {{beta}};
    }
    thermodynamics
    {
        Cv              718;
        hf              0;
    }
    transport
    {
        mu              {{mu}};
        Pr              {{Pr}};
    }
}

