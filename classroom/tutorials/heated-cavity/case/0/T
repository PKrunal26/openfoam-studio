FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform {{Tmean}};

boundaryField
{
    hotWall
    {
        type            fixedValue;
        value           uniform {{Thot}};
    }

    coldWall
    {
        type            fixedValue;
        value           uniform {{Tcold}};
    }

    adiabaticWalls
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

