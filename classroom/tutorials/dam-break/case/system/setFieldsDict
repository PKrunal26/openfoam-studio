FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fill a box with water (alpha.water = 1); everything else is air.

defaultValues
{
    alpha.water     0;
}

zones
{
    waterColumn
    {
        type            box;
        box             (0 0 -1) ({{columnWidth}} {{columnHeight}} 1);

        values
        {
            alpha.water     1;
        }
    }
}

