          ],
          "description": "Frictionless boundaries standing in for the far field.",
          "files": [
            "0/U",
            "0/p"
          ],
          "rows": [
            {
              "label": "Velocity type",
              "value": "slip"
            },
            {
              "label": "Pressure type",
              "value": "zeroGradient"
            }
          ]
        },
        {
          "id": "bcCylinder",
          "label": "Cylinder",
          "icon": "wall",
          "patches": [
            "cylinder"
          ],
          "description": "No-slip wall. Drag and lift are integrated over this patch.",
          "files": [
            "0/U",
