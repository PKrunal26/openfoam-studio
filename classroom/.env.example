# Copy to classroom/.env and edit. Never commit the real file.

# Shown on the sign-in page and dashboard.
OFS_CLASS_NAME=CFD with OpenFOAM

# Students need this once, to create their account. Share it in class.
OFS_CLASS_CODE=change-me

# Unlocks the instructor overview at /admin. Keep it to yourself.
OFS_INSTRUCTOR_CODE=change-me-too

# Public DNS name of the server, e.g. cfd.example.edu, for automatic HTTPS.
# Leave as :80 to serve plain HTTP on the server's IP address.
OFS_DOMAIN=:80
# Set to 1 once the site is served over HTTPS so cookies are HTTPS-only.
OFS_SECURE_COOKIES=0

# How many simulations may run at the same time. Each uses up to 2 CPU cores
# and 2 GB of memory, so use about (vCPUs / 2).
OFS_MAX_CONCURRENT_RUNS=2

# Per-student limits.
OFS_MAX_RUNS_PER_TUTORIAL=8
OFS_MAX_RUNS_PER_DAY=40

# Disk budget for stored results, in GB. Old results nobody uses are removed first.
OFS_CACHE_MAX_GB=20

# Where accounts, workspaces and results are stored on the host.
OFS_CLASSROOM_DATA=/srv/ofs-classroom
